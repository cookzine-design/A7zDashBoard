[Unit]
Description=Cubie Watch Directory Converter
After=local-fs.target

[Service]
Type=simple
User=cubie
Group=cubie
WorkingDirectory=/opt/cubie-dashboard
ExecStart=/opt/cubie-dashboard/.venv/bin/python /opt/cubie-dashboard/worker/watcher.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
